{
  "name": "agent-bench-website",
  "version": "0.3.0",
  "private": true,
  "description": "Embodied Playground / AgentBench environment website",
  "scripts": {
    "dev": "python3 -m http.server 4174 --bind 127.0.0.1",
    "start": "python3 -m http.server 4174 --bind 127.0.0.1",
    "build": "python3 scripts/check_site.py",
    "check": "python3 scripts/check_site.py",
    "sync": "python3 scripts/sync_benchmark.py && python3 scripts/sync_media.py",
    "check:sync": "python3 scripts/sync_benchmark.py --check && python3 scripts/sync_media.py --check",
    "build:outlines": "python3 scripts/build_framework.py"
  }
}
